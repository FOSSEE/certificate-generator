%% Fixed-size logo box
%% All logos will be placed inside the same 3.5cm x 2.5cm box
%% and centered vertically/horizontally.
\newcommand{\LogoBox}[1]{%
  \begin{minipage}[c][2.5cm][c]{3.5cm}
    \centering
    \includegraphics[width=3.5cm,height=2.5cm,keepaspectratio]{#1}
  \end{minipage}%
}

